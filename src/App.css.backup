/* Image frame with subtle overlay */
.image-frame {
  border-radius: 24px;
  overflow: hidden;
  border: 1px solid rgba(255,255,255,.08);
  box-shadow: var(--shadow);
  position: relative;
}

.image-frame::after {
  content: '';
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, transparent 40%, rgba(15,9,21,0.3) 100%);
  pointer-events: none;
}

.image-frame.portrait {
  aspect-ratio: 4/5;
  min-height: 400px;
}

.image-frame img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.5s ease;
}

.image-frame:hover img {
  transform: scale(1.03);
}

/* Page Hero */
.page-hero {
  padding: 80px 0 60px;
  border-bottom: 1px solid rgba(255,255,255,.06);
  background: var(--bg-soft);
}

.page-hero h1 {
  font-size: clamp(2.7rem, 6vw, 5.2rem);
  max-width: 950px;
}

.breadcrumbs {
  display: flex;
  gap: 8px;
  align-items: center;
  color: var(--muted);
  font-size: .88rem;
  margin-bottom: 24px;
}

.breadcrumbs a:hover {
  color: var(--gold-light);
}

.breadcrumbs span {
  color: var(--gold-light);
}

/* Form Card */
.form-card {
  padding: 32px;
}

.form-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18px;
}

.field {
  display: grid;
  gap: 8px;
}

.field.full {
  grid-column: 1 / -1;
}

.field label {
  color: #f0e7f4;
  font-weight: 700;
  font-size: .92rem;
}

.field input,
.field textarea,
.field select {
  width: 100%;
  border-radius: 13px;
  border: 1px solid rgba(255,255,255,.12);
  background: #140d1b;
  color: var(--ink);
  padding: 13px 14px;
  outline: none;
  font-size: 16px;
}

.field input:focus,
.field textarea:focus,
.field select:focus {
  border-color: var(--gold);
  box-shadow: 0 0 0 3px rgba(216,181,108,.12);
}

.field textarea {
  min-height: 150px;
  resize: vertical;
}

.form-status {
  min-height: 28px;
  margin-top: 12px;
  color: var(--gold-light);
}

/* Contact List */
.contact-list {
  display: grid;
  gap: 14px;
  margin-top: 26px;
}

.contact-item {
  padding: 18px;
  border-radius: 16px;
  border: 1px solid rgba(255,255,255,.08);
  background: rgba(255,255,255,.03);
}

.contact-item strong {
  display: block;
  color: var(--gold-light);
  margin-bottom: 4px;
}

.whatsapp-contact-link {
  display: inline-flex;
  align-items: center;
  gap: 9px;
  color: #79e39f;
  font-weight: 800;
}

.whatsapp-contact-link:hover {
  color: #a5f1bf;
}

/* FAQ */
.faq-list {
  display: grid;
  gap: 14px;
}

.faq-item {
  border: 1px solid rgba(255,255,255,.08);
  border-radius: 18px;
  background: rgba(255,255,255,.03);
  overflow: hidden;
}

.faq-question {
  width: 100%;
  text-align: left;
  background: transparent;
  border: 0;
  color: var(--ink);
  padding: 20px 58px 20px 22px;
  font-weight: 800;
  font-size: 18px;
  position: relative;
  cursor: pointer;
}

.faq-question::after {
  content: "+";
  position: absolute;
  right: 22px;
  top: 16px;
  color: var(--gold-light);
  font-size: 1.5rem;
}

.faq-item.open .faq-question::after {
  content: "−";
}

.faq-answer {
  display: none;
  padding: 0 22px 20px;
  color: var(--muted);
}

.faq-item.open .faq-answer {
  display: block;
}

/* CTA Panel */
.cta-panel {
  padding: clamp(34px, 6vw, 70px);
  border-radius: 36px;
  background:
    radial-gradient(circle at 90% 0%, rgba(216,181,108,.2), transparent 36%),
    linear-gradient(135deg, #2a1738, #160f1c);
  border: 1px solid var(--line);
  box-shadow: var(--shadow);
}

.cta-panel .lead {
  max-width: 680px;
  margin-inline: auto;
}

/* Section Alt */
.section-alt {
  background: rgba(255,255,255,.025);
  border-block: 1px solid rgba(255,255,255,.05);
}

/* Responsive fixes for pages */
@media (max-width: 820px) {
  .form-grid {
    grid-template-columns: 1fr;
  }
  
  .field.full {
    grid-column: auto;
  }
  
  .page-hero {
    padding: 60px 0 40px;
  }
}

@media (max-width: 560px) {
  .form-card {
    padding: 20px;
  }
  
  .faq-question {
    font-size: 16px;
    padding: 16px 48px 16px 16px;
  }
  
  .faq-question::after {
    right: 16px;
    top: 12px;
    font-size: 1.2rem;
  }
  
  .cta-panel {
    padding: 30px 20px;
  }
}

.feature-list li::before {
  content: "✦";
  width: 24px;
  height: 24px;
  display: grid;
  place-items: center;
  border-radius: 50%;
  background: rgba(216,181,108,.12);
  color: var(--gold-light);
  font-weight: 900;
}

/* ============================================
   INCREASED FONT SIZES
   ============================================ */

/* Base body text - larger */
body {
  font-size: 20px;
  line-height: 1.8;
}

/* Headings - larger */
h1 { font-size: clamp(3.5rem, 8vw, 6.5rem); letter-spacing: -0.045em; }
h2 { font-size: clamp(2.8rem, 5.5vw, 4.5rem); letter-spacing: -0.035em; }
h3 { font-size: clamp(1.8rem, 3vw, 2.4rem); }
h4 { font-size: 1.4rem; }

/* Paragraphs - larger */
p, .lead {
  font-size: 1.2rem;
  line-height: 1.9;
}

.lead {
  font-size: clamp(1.2rem, 2.2vw, 1.6rem);
}

/* Navigation - larger */
.nav-links a {
  font-size: 1.05rem;
  padding: 12px 16px;
}

.brand-name {
  font-size: 1.5rem;
}

/* Buttons - larger */
.btn {
  font-size: 1.1rem;
  min-height: 56px;
  padding: 16px 32px;
}

.btn-sm {
  font-size: 1rem;
  min-height: 48px;
  padding: 12px 24px;
}

/* Cards - larger */
.card-body {
  padding: 32px;
}

.card-body h3 {
  font-size: 1.6rem;
}

.card-body p {
  font-size: 1.05rem;
}

/* Service tags - larger */
.service-tag {
  font-size: 1rem;
  padding: 10px 24px;
}

/* Footer - larger */
.footer-title {
  font-size: 1.2rem;
}

.footer-links a {
  font-size: 1.05rem;
}

/* Trust pills - larger */
.trust-pill {
  font-size: 1rem;
  padding: 12px 18px;
}

/* Step cards - larger */
.step h3 {
  font-size: 1.5rem;
}

.step p {
  font-size: 1.1rem;
}

/* Feature list - larger */
.feature-list li {
  font-size: 1.1rem;
  padding: 12px 0;
}

/* FAQ - larger */
.faq-question {
  font-size: 1.2rem;
  padding: 24px 64px 24px 28px;
}

.faq-answer p {
  font-size: 1.1rem;
}

/* Contact form - larger */
.contact-item strong {
  font-size: 1.1rem;
}

.contact-item a {
  font-size: 1.2rem;
}

.field label {
  font-size: 1.05rem;
}

.field input,
.field textarea {
  font-size: 1.05rem;
  padding: 15px 18px;
}

/* Page hero - larger */
.page-hero h1 {
  font-size: clamp(3.5rem, 7vw, 5.5rem);
}

.page-hero .lead {
  font-size: 1.4rem;
}

/* Breadcrumbs - larger */
.breadcrumbs {
  font-size: 1rem;
}

/* CTA panel - larger */
.cta-panel h2 {
  font-size: clamp(2.5rem, 5vw, 4rem);
}

.cta-panel .lead {
  font-size: 1.3rem;
}

/* Floating buttons - larger */
.call-float {
  font-size: 1.1rem;
  min-height: 64px;
  padding: 14px 24px;
}

.whatsapp-float {
  font-size: 1.1rem;
  min-height: 64px;
  padding: 14px 24px;
}

/* Eyebrow - larger */
.eyebrow {
  font-size: 0.9rem;
  letter-spacing: 0.2em;
}

/* Responsive adjustments */
@media (max-width: 820px) {
  body {
    font-size: 18px;
  }
  
  h1 { font-size: clamp(2.8rem, 6vw, 4rem); }
  h2 { font-size: clamp(2.2rem, 4.5vw, 3.2rem); }
  h3 { font-size: clamp(1.5rem, 2.5vw, 2rem); }
  
  p, .lead {
    font-size: 1.1rem;
  }
  
  .btn {
    font-size: 1rem;
    padding: 14px 28px;
    min-height: 50px;
  }
  
  .nav-links a {
    font-size: 1rem;
  }
}

@media (max-width: 560px) {
  body {
    font-size: 16px;
  }
  
  h1 { font-size: clamp(2.2rem, 5vw, 3rem); }
  h2 { font-size: clamp(1.8rem, 4vw, 2.6rem); }
  h3 { font-size: clamp(1.3rem, 2vw, 1.7rem); }
  
  p, .lead {
    font-size: 1rem;
  }
  
  .btn {
    font-size: 0.95rem;
    padding: 12px 24px;
    min-height: 46px;
  }
  
  .trust-pill {
    font-size: 0.9rem;
    padding: 8px 14px;
  }
  
  .feature-list li {
    font-size: 1rem;
  }
  
  .faq-question {
    font-size: 1.05rem;
  }
}
